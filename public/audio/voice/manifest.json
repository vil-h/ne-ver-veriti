      "peak": 0.4366,
      "sha256": "aeae0b7e63da9655a105686066a3a93f407bc7785d000462cb30c0baf511d71c"
    },
    {
      "file": "audio/voice/15-pit-stop.mp3",
      "text": "Стой… Не надо прыгать.",
      "emotion": "friendly",
      "seconds": 1.661,
