      "sha256": "41cddfaf5db7d2fdea3a141bcfc3db80d6d0a492e7d5bae32d0a3f81cc2938c5"
    },
    {
      "file": "audio/voice/demo-angry.mp3",
      "text": "Я же просил тебя не нажимать!",
